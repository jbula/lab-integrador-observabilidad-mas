# Variables de entorno del laboratorio OTel (copiar a .env)
ENVIRONMENT=development
CLOUD_PROVIDER=local
# Credenciales de la base de datos (local). En AWS van por Secrets Manager.
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
# Terraform (modo AWS, entregable validado — NO se aplica)
AWS_REGION=us-east-1
AWS_PROFILE=
TF_VAR_allowed_cidr=0.0.0.0/32
